            "url": "{{baseUrl}}/api/login"
          }
        },
        {
          "name": "Get User Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api-key}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/23"
          }
        }
      ]
    },
    {
      "name": "Monitor API",
      "item": [
        {
          "name": "Availability and SLA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Availability: status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Performance: response time is below 800ms', function () { pm.expect(pm.response.responseTime).to.be.below(800); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{api-key}}"
              }
            ],
            "url": "{{baseUrl}}/api/users?page=1"
          }
        }
      ]
    }
  ]
}